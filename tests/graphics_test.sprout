import pixelgarden as pix
import starbloom3d as star

test "PixelGarden sprites, layers, and animation":
  canvas = pix.canvas(8, 4, ".")
  actor = pix.sprite_asset(["ab", "cd"])
  layer = pix.layer(8, 4)
  pix.draw_sprite(layer, actor, 2, 1, flip_x=true)
  pix.composite(canvas, layer)
  expect(canvas.rows[1].join("")).to_equal("..ba....")
  expect(canvas.rows[2].join("")).to_equal("..dc....")

  animation = pix.animation([actor, pix.sprite_asset(["*"])], fps=2)
  expect(pix.animation_frame(animation, 0).width).to_equal(2)
  expect(pix.animation_frame(animation, 0.6).width).to_equal(1)

test "PixelGarden world drawing":
  canvas = pix.canvas(9, 5)
  camera = pix.camera(pix.vec2(0, 0))
  pix.line_world(canvas, pix.vec2(-2, 0), pix.vec2(2, 0), camera, "-")
  expect(canvas.rows[2].join("")).to_contain("-----")

test "StarBloom3D primitives and transforms":
  shape = star.pyramid(size=4, height=3)
  expect(len(shape.vertices)).to_equal(5)
  expect(len(shape.faces)).to_equal(6)
  moved = star.transform_mesh(shape, position=star.vec3(1, 2, 3), scale=2)
  expect(moved.vertices[4]).to_equal(star.vec3(1, 8, 3))

test "StarBloom3D scene composition":
  camera = star.camera(star.vec3(0, 0, -6), fov=18)
  world = star.scene(camera, width=24, height=12)
  star.add(world, star.object(star.cube(), position=star.vec3(-1, 0, 6), char="*"))
  star.add(world, star.object(star.pyramid(), position=star.vec3(2, 0, 7), char="+"))
  combined = star.scene_mesh(world)
  expect(len(world.objects)).to_equal(2)
  expect(len(combined.vertices)).to_equal(13)
  expect(star.frame_to_text(star.render(world))).to_contain("*")
