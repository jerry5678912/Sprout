import "modules/gamekit.sprout" as game
importpython random as pyrandom

pyrandom.seed(3)

name = "Sproutling"
if len(argv) > 0 {
  name = argv[0]
}

hero = game.make_player(name)
map_text = readfile("data/tiny_map.txt")
map_rows = lines(map_text)

say sparkle("Tiny Adventure")
say "module:", type(game), game.status(hero)
say "map rows:", len(map_rows)

turn = 0
while turn < 4 {
  direction = choose(game.directions)
  game.move(hero, direction, 8, 5)
  if pyrandom.randint(1, 3) == 1 {
    game.hurt(hero, 1)
  } else {
    game.heal(hero, 1)
  }
  say "turn", turn, direction, game.status(hero)
  turn = turn + 1
}

say "first map line:", first(map_rows)
