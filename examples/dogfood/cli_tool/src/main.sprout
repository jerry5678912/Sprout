def parse_task(raw):
  parts = raw.split(":")
  name = parts[0]
  effort = 1
  if len(parts) > 1:
    effort = int(parts[1])
  return {"name": name, "effort": effort}

def render_help():
  say "Sprout Tasker"
  say "usage: sprout_tasker add name:effort ..."
  say "example: add docs:2 tests:3 release:5"

def render_plan(args):
  tasks = []
  total = 0
  for raw in args:
    task = parse_task(raw)
    tasks.append(task)
    total = total + task.effort

  say "plan items:", len(tasks)
  for task in tasks:
    bar = chant("#", task.effort)
    say "- " + task.name + " " + bar + " " + str(task.effort)
  say "total effort:", total

if len(argv) == 0 or argv[0] == "help":
  render_help()
else if argv[0] == "add":
  render_plan(argv[1:])
else:
  say "unknown command:", argv[0]
  render_help()
