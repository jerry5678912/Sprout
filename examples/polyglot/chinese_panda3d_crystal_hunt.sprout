language "chinese-pack"

# 《月光水晶追猎》：使用真实 Panda3D 窗口的中文 Sprout 3D 游戏。
# 玩法：WASD 或方向键移动，收集全部水晶并避开红色守卫。
# 运行：python3 sprout.py run examples/polyglot/chinese_panda3d_crystal_hunt.sprout
# 自动验证：python3 sprout.py run examples/polyglot/chinese_panda3d_crystal_hunt.sprout --演示 --离屏

导入 panda3d_window 作为 三维

演示模式 = 包含值(argv, "--演示")
离屏模式 = 包含值(argv, "--离屏")

如果 非 三维.available():
  输出 "缺少 Panda3D。请运行：python3 -m pip install panda3d"
否则:
  如果 离屏模式:
    启动核心 = 导入Python模块("panda3d.core")
    启动核心.loadPrcFileData("", "window-type offscreen")
    启动核心.loadPrcFileData("", "audio-library-name null")

  世界 = 三维.window("Sprout 3D：月光水晶追猎")
  核心 = 世界.core
  程序 = 世界.base
  程序.setBackgroundColor(0.025, 0.04, 0.09, 1)

  # 柔和环境光与月光方向光。
  环境光 = 核心.AmbientLight("环境光")
  环境光.setColor(核心.Vec4(0.22, 0.26, 0.38, 1))
  环境光节点 = 程序.render.attachNewNode(环境光)
  程序.render.setLight(环境光节点)

  月光 = 核心.DirectionalLight("月光")
  月光.setColor(核心.Vec4(0.72, 0.82, 1, 1))
  月光.setDirection(核心.Vec3(-1, 1, -2))
  月光节点 = 程序.render.attachNewNode(月光)
  程序.render.setLight(月光节点)

  # 地面与边界。
  地面 = 三维.load_model(世界, "models/box")
  地面.setScale(12, 12, 0.18)
  地面.setPos(0, 0, -0.45)
  地面.setColor(0.08, 0.13, 0.2, 1)

  定义 创建边墙(x, y, 宽, 深):
    墙 = 三维.load_model(世界, "models/box")
    墙.setScale(宽, 深, 0.8)
    墙.setPos(x, y, 0.15)
    墙.setColor(0.14, 0.2, 0.3, 1)
    返回 墙

  创建边墙(0, 12, 12, 0.25)
  创建边墙(0, -12, 12, 0.25)
  创建边墙(12, 0, 0.25, 12)
  创建边墙(-12, 0, 0.25, 12)

  # 玩家使用 Panda3D 自带的 smiley 模型。
  玩家 = 三维.load_model(世界, "models/smiley")
  玩家.setScale(0.55)
  玩家.setPos(0, -8, 0.6)
  玩家.setColor(0.35, 0.9, 1, 1)
  玩家_x = 0
  玩家_y = -8
  生命 = 3
  令 无敌时间: Number = 0.0
  已收集 = 0

  定义 创建水晶(x, y, 相位):
    节点 = 三维.load_model(世界, "models/misc/rgbCube")
    节点.setScale(0.28, 0.28, 0.55)
    节点.setPos(x, y, 0.75)
    节点.setColorScale(0.25, 0.95, 1, 1)
    返回 {"节点": 节点, "x": x, "y": y, "相位": 相位, "已收集": 假}

  水晶们 = [
    创建水晶(-8, -7, 0),
    创建水晶(-3, -3, 1),
    创建水晶(4, -7, 2),
    创建水晶(8, -1, 3),
    创建水晶(4, 5, 4),
    创建水晶(-2, 8, 5),
    创建水晶(-8, 4, 6)
  ]

  定义 创建守卫(x, y, 半径, 速度, 相位):
    节点 = 三维.load_model(世界, "models/box")
    节点.setScale(0.58)
    节点.setPos(x, y, 0.55)
    节点.setColor(1, 0.18, 0.12, 1)
    返回 {
      "节点": 节点,
      "中心_x": x,
      "中心_y": y,
      "半径": 半径,
      "速度": 速度,
      "相位": 相位,
      "x": x,
      "y": y
    }

  守卫们 = [
    创建守卫(-4, 1, 3.2, 0.85, 0),
    创建守卫(5, 2, 3.6, -0.7, 2),
    创建守卫(0, 6, 2.4, 1.1, 4)
  ]

  # 石柱让竞技场更有空间层次。
  柱子位置 = [[-9, -2], [9, 6], [-6, 9], [7, -8]]
  对于 位置 在 柱子位置:
    柱子 = 三维.load_model(世界, "models/box")
    柱子.setScale(0.75, 0.75, 1.8)
    柱子.setPos(位置[0], 位置[1], 1.35)
    柱子.setColor(0.18, 0.25, 0.36, 1)

  # 中文 HUD；macOS 上优先使用系统中文字体。
  屏幕文字模块 = 导入Python模块("direct.gui.OnscreenText")
  屏幕文字类 = 屏幕文字模块.OnscreenText
  字体路径 = "/System/Library/Fonts/STHeiti Light.ttc"
  中文字体 = 空
  令 状态文字: Any = 空
  令 说明文字: Any = 空
  如果 路径存在(字体路径):
    中文字体 = 程序.loader.loadFont(字体路径)

  如果 中文字体:
    状态文字 = 屏幕文字类(
      text="",
      pos=[-1.28, 0.9],
      scale=0.055,
      fg=[0.75, 0.92, 1, 1],
      mayChange=真,
      font=中文字体
    )
    说明文字 = 屏幕文字类(
      text="WASD / 方向键移动　收集水晶　Esc 退出",
      pos=[0, -0.92],
      scale=0.045,
      fg=[0.82, 0.86, 0.94, 1],
      font=中文字体
    )
  否则:
    状态文字 = 屏幕文字类(
      text="",
      pos=[-1.28, 0.9],
      scale=0.055,
      fg=[0.75, 0.92, 1, 1],
      mayChange=真
    )
    说明文字 = 屏幕文字类(
      text="WASD / Arrow keys: move    Esc: quit",
      pos=[0, -0.92],
      scale=0.045,
      fg=[0.82, 0.86, 0.94, 1]
    )

  # 第三人称相机。
  程序.disableMouse()
  程序.camera.setPos(0, -21, 15)
  程序.camera.lookAt(玩家)

  左键 = 核心.ButtonHandle("a")
  右键 = 核心.ButtonHandle("d")
  前键 = 核心.ButtonHandle("w")
  后键 = 核心.ButtonHandle("s")
  退出键 = 核心.ButtonHandle("escape")
  方向左 = 核心.ButtonHandle("arrow_left")
  方向右 = 核心.ButtonHandle("arrow_right")
  方向上 = 核心.ButtonHandle("arrow_up")
  方向下 = 核心.ButtonHandle("arrow_down")

  定义 按下(按键):
    返回 程序.mouseWatcherNode.isButtonDown(按键)

  定义 平方距离(x1, y1, x2, y2):
    dx = x1 - x2
    dy = y1 - y2
    返回 dx * dx + dy * dy

  定义 寻找最近水晶():
    最近 = 空
    最近距离 = 999999
    对于 水晶 在 水晶们:
      如果 非 水晶.已收集:
        距离 = 平方距离(玩家_x, 玩家_y, 水晶.x, 水晶.y)
        如果 距离 < 最近距离:
          最近 = 水晶
          最近距离 = 距离
    返回 最近

  游戏运行 = 真
  胜利 = 假
  令 经过时间: Number = 0.0
  帧数 = 0
  水晶总数 = 长度(水晶们)
  上一帧时间 = 当前时间()
  令 dt: Number = 1 / 30

  当 游戏运行:
    程序.taskMgr.step()
    帧数 = 帧数 + 1

    如果 演示模式:
      dt = 1 / 30
    否则:
      本帧时间 = 当前时间()
      dt = 最小值(本帧时间 - 上一帧时间, 0.05)
      上一帧时间 = 本帧时间
    经过时间 = 经过时间 + dt
    无敌时间 = 最大值(0, 无敌时间 - dt)

    移动_x = 0
    移动_y = 0
    如果 演示模式:
      目标 = 寻找最近水晶()
      如果 目标:
        移动_x = 目标.x - 玩家_x
        移动_y = 目标.y - 玩家_y
    否则:
      如果 按下(左键) 或 按下(方向左):
        移动_x = 移动_x - 1
      如果 按下(右键) 或 按下(方向右):
        移动_x = 移动_x + 1
      如果 按下(前键) 或 按下(方向上):
        移动_y = 移动_y + 1
      如果 按下(后键) 或 按下(方向下):
        移动_y = 移动_y - 1
      如果 按下(退出键):
        游戏运行 = 假

    移动长度 = 平方根(移动_x * 移动_x + 移动_y * 移动_y)
    如果 移动长度 > 0:
      移动_x = 移动_x / 移动长度
      移动_y = 移动_y / 移动长度
      玩家_x = 限定范围(玩家_x + 移动_x * 6 * dt, -10.8, 10.8)
      玩家_y = 限定范围(玩家_y + 移动_y * 6 * dt, -10.8, 10.8)
      玩家.setH(转为角度(双参数反正切(移动_x, 移动_y)))

    玩家.setPos(玩家_x, 玩家_y, 0.6)

    对于 水晶 在 水晶们:
      如果 非 水晶.已收集:
        水晶.节点.setH(经过时间 * 90 + 水晶.相位 * 25)
        水晶.节点.setZ(0.75 + 正弦(经过时间 * 2.5 + 水晶.相位) * 0.18)
        如果 平方距离(玩家_x, 玩家_y, 水晶.x, 水晶.y) < 0.8:
          水晶.已收集 = 真
          水晶.节点.removeNode()
          已收集 = 已收集 + 1
          输出 "收集到月光水晶：", 已收集, "/", 水晶总数

    对于 守卫 在 守卫们:
      角度 = 经过时间 * 守卫.速度 + 守卫.相位
      守卫.x = 守卫.中心_x + 余弦(角度) * 守卫.半径
      守卫.y = 守卫.中心_y + 正弦(角度) * 守卫.半径
      守卫.节点.setPos(守卫.x, 守卫.y, 0.55)
      守卫.节点.setH(经过时间 * 130)
      如果 非 演示模式 且 无敌时间 <= 0 且 平方距离(玩家_x, 玩家_y, 守卫.x, 守卫.y) < 1.2:
        生命 = 生命 - 1
        无敌时间 = 1.5
        玩家_x = 0
        玩家_y = -8
        输出 "被守卫击中！剩余生命：", 生命

    # 相机平滑跟随玩家，始终朝向角色。
    相机_x = 玩家_x * 0.35
    相机_y = 玩家_y - 13
    程序.camera.setPos(相机_x, 相机_y, 10)
    程序.camera.lookAt(玩家)

    状态文字.setText("生命：" + 文本(生命) + "　水晶：" + 文本(已收集) + "/" + 文本(水晶总数))

    如果 已收集 == 水晶总数:
      胜利 = 真
      游戏运行 = 假
    如果 生命 <= 0:
      游戏运行 = 假
    如果 非 程序.win.getProperties().getOpen():
      游戏运行 = 假
    如果 演示模式 且 帧数 > 900:
      游戏运行 = 假

    如果 非 演示模式:
      休眠(0.001)

  如果 胜利:
    输出 "胜利！全部月光水晶已经回到祭坛。"
  否则如果 生命 <= 0:
    输出 "游戏结束：守卫夺回了竞技场。"
  否则如果 演示模式:
    输出 "演示结束：已收集", 已收集, "/", 水晶总数

  程序.destroy()
