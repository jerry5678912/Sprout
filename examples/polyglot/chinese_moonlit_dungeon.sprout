language "chinese-pack"

# 《月影地牢》：一款完整的中文终端冒险游戏。
# 运行：sprout run examples/polyglot/chinese_moonlit_dungeon.sprout
# 演示：sprout run examples/polyglot/chinese_moonlit_dungeon.sprout --演示

设置随机种子(17)


类 冒险者:
  定义 init(self, 名字):
    self.名字 = 名字
    self.最大生命 = 40
    self.生命 = self.最大生命
    self.攻击力 = 5
    self.护甲 = 0
    self.金币 = 0
    self.分数 = 0
    self.药水 = 1
    self.背包 = []

  定义 存活(self):
    返回 self.生命 > 0

  定义 受到伤害(self, 数量):
    实际伤害 = 最大值(1, 数量 - self.护甲)
    self.生命 = 最大值(0, self.生命 - 实际伤害)
    返回 实际伤害

  定义 治疗(self, 数量):
    原生命 = self.生命
    self.生命 = 最小值(self.最大生命, self.生命 + 数量)
    返回 self.生命 - 原生命

  定义 使用药水(self):
    如果 self.药水 <= 0:
      返回 0
    self.药水 = self.药水 - 1
    返回 self.治疗(12)

  定义 获得物品(self, 物品):
    self.背包.追加(物品)

  定义 状态(self):
    物品文本 = "空"
    如果 self.背包.长度() > 0:
      物品文本 = self.背包.拼接("、")
    状态文本 = self.名字 + "｜生命 " + 文本(self.生命) + "/" + 文本(self.最大生命)
    状态文本 = 状态文本 + "｜攻击 " + 文本(self.攻击力)
    状态文本 = 状态文本 + "｜护甲 " + 文本(self.护甲)
    状态文本 = 状态文本 + "｜药水 " + 文本(self.药水)
    状态文本 = 状态文本 + "｜金币 " + 文本(self.金币)
    状态文本 = 状态文本 + "｜背包 " + 物品文本
    返回 状态文本


类 敌人:
  定义 init(self, 名字, 生命, 最小伤害, 最大伤害, 奖励):
    self.名字 = 名字
    self.生命 = 生命
    self.最小伤害 = 最小伤害
    self.最大伤害 = 最大伤害
    self.奖励 = 奖励

  定义 存活(self):
    返回 self.生命 > 0

  定义 受到伤害(self, 数量):
    self.生命 = 最大值(0, self.生命 - 数量)

  定义 攻击(self):
    返回 随机整数(self.最小伤害, self.最大伤害)


类 地牢游戏:
  定义 init(self, 玩家, 演示模式):
    self.玩家 = 玩家
    self.演示模式 = 演示模式
    self.房间编号 = 0
    self.战斗回合 = 0
    self.游戏结束 = 假
    self.胜利 = 假
    self.演示路线 = ["状态", "前进", "前进", "前进", "前进"]
    self.路线位置 = 0

  定义 读取探索命令(self):
    如果 self.演示模式:
      命令 = "前进"
      如果 self.路线位置 < self.演示路线.长度():
        命令 = self.演示路线[self.路线位置]
        self.路线位置 = self.路线位置 + 1
      输出 "> " + 命令
      返回 命令
    返回 输入("> ")

  定义 读取战斗命令(self):
    如果 self.演示模式:
      如果 self.玩家.生命 <= 12 且 self.玩家.药水 > 0:
        输出 "战斗选择> 药水"
        返回 "药水"
      如果 self.战斗回合 % 4 == 3:
        输出 "战斗选择> 防御"
        返回 "防御"
      输出 "战斗选择> 攻击"
      返回 "攻击"
    返回 输入("战斗选择（攻击/防御/药水/逃跑）> ")

  定义 显示帮助(self):
    输出 ""
    输出 "可用命令："
    输出 "  前进  进入下一个房间"
    输出 "  状态  查看角色资料"
    输出 "  药水  恢复生命"
    输出 "  休息  花费 4 金币恢复生命"
    输出 "  帮助  再次显示命令"
    输出 "  退出  离开游戏"
    输出 ""

  定义 战斗(self, 对手, 可以逃跑):
    输出 ""
    输出 "【遭遇】" + 对手.名字 + " 出现了！"
    防御中 = 假
    self.战斗回合 = 0

    当 self.玩家.存活() 且 对手.存活():
      战况 = self.玩家.名字 + " " + 文本(self.玩家.生命) + "生命"
      战况 = 战况 + "  对阵  " + 对手.名字 + " " + 文本(对手.生命) + "生命"
      输出 战况
      命令 = self.读取战斗命令()
      防御中 = 假

      如果 命令 == "攻击":
        伤害 = self.玩家.攻击力 + 随机整数(0, 3)
        对手.受到伤害(伤害)
        输出 "你挥剑造成 " + 文本(伤害) + " 点伤害。"
      否则如果 命令 == "防御":
        防御中 = 真
        输出 "你稳住脚步，准备格挡下一次攻击。"
      否则如果 命令 == "药水":
        恢复量 = self.玩家.使用药水()
        如果 恢复量 > 0:
          输出 "你饮下药水，恢复 " + 文本(恢复量) + " 点生命。"
        否则:
          输出 "药水袋已经空了。"
          继续
      否则如果 命令 == "逃跑" 且 可以逃跑:
        如果 随机整数(1, 100) <= 45:
          输出 "你借着阴影成功脱离战斗。"
          返回 假
        输出 "退路被封住了！"
      否则:
        输出 "无法识别这个战斗命令。"
        继续

      如果 对手.存活():
        敌人伤害 = 对手.攻击()
        如果 防御中:
          敌人伤害 = 最大值(1, 敌人伤害 - 4)
        实际伤害 = self.玩家.受到伤害(敌人伤害)
        输出 对手.名字 + " 反击，造成 " + 文本(实际伤害) + " 点伤害。"

      self.战斗回合 = self.战斗回合 + 1

    如果 self.玩家.存活():
      self.玩家.金币 = self.玩家.金币 + 对手.奖励
      self.玩家.分数 = self.玩家.分数 + 对手.奖励 * 10
      输出 "你击败了 " + 对手.名字 + "，获得 " + 文本(对手.奖励) + " 枚金币。"
      返回 真

    输出 "你的意识沉入了无边的月影……"
    self.游戏结束 = 真
    返回 假

  定义 进入房间(self):
    输出 ""
    如果 self.房间编号 == 0:
      输出 "【苔痕门厅】月光从破碎的穹顶落下。"
      输出 "石台上放着一瓶药水和一面青铜护符。"
      self.玩家.药水 = self.玩家.药水 + 1
      self.玩家.护甲 = self.玩家.护甲 + 1
      self.玩家.获得物品("青铜护符")
      self.玩家.分数 = self.玩家.分数 + 20
      输出 "获得：药水 ×1，青铜护符（护甲 +1）。"
    否则如果 self.房间编号 == 1:
      输出 "【回声长廊】墙后的脚步声突然逼近。"
      self.战斗(敌人("石甲守卫", 16, 3, 6, 6), 真)
    否则如果 self.房间编号 == 2:
      输出 "【星泉密室】清澈泉水映出遥远的星空。"
      恢复量 = self.玩家.治疗(self.玩家.最大生命)
      self.玩家.攻击力 = self.玩家.攻击力 + 2
      self.玩家.获得物品("星泉祝福")
      self.玩家.分数 = self.玩家.分数 + 30
      输出 "泉水恢复 " + 文本(恢复量) + " 点生命，并使攻击 +2。"
    否则如果 self.房间编号 == 3:
      输出 "【月蚀王座】地牢领主从黑曜石王座起身。"
      赢得首领战 = self.战斗(敌人("月蚀领主", 30, 5, 9, 15), 假)
      如果 赢得首领战:
        self.胜利 = 真
        self.游戏结束 = 真
        self.玩家.获得物品("月影核心")
        self.玩家.分数 = self.玩家.分数 + 200

  定义 执行探索命令(self, 命令):
    如果 命令 == "前进":
      self.进入房间()
      如果 self.玩家.存活() 且 非 self.游戏结束:
        self.房间编号 = self.房间编号 + 1
    否则如果 命令 == "状态":
      输出 self.玩家.状态()
    否则如果 命令 == "药水":
      恢复量 = self.玩家.使用药水()
      输出 "恢复生命：" + 文本(恢复量)
    否则如果 命令 == "休息":
      如果 self.玩家.金币 >= 4:
        self.玩家.金币 = self.玩家.金币 - 4
        恢复量 = self.玩家.治疗(8)
        输出 "你在营火旁休息，恢复 " + 文本(恢复量) + " 点生命。"
      否则:
        输出 "至少需要 4 枚金币才能安全休息。"
    否则如果 命令 == "帮助":
      self.显示帮助()
    否则如果 命令 == "退出":
      self.游戏结束 = 真
      输出 "你暂时离开了月影地牢。"
    否则:
      输出 "未知命令。输入“帮助”查看可用操作。"

  定义 启动冒险(self):
    输出 "================================"
    输出 "          月 影 地 牢"
    输出 "================================"
    输出 "欢迎，" + self.玩家.名字 + "。找到月影核心，击败地牢领主。"
    self.显示帮助()

    当 非 self.游戏结束:
      命令 = self.读取探索命令()
      self.执行探索命令(命令)

    输出 ""
    如果 self.胜利:
      输出 "月影核心在你手中重新亮起。地牢得救了！"
    否则如果 非 self.玩家.存活():
      输出 "冒险结束。下一位勇者会记住你的名字。"
    输出 "最终状态：" + self.玩家.状态()
    输出 "最终分数：" + 文本(self.玩家.分数)


演示模式 = 包含值(argv, "--演示")
玩家名字 = "无名旅者"
如果 argv.长度() > 0 且 argv[0] != "--演示":
  玩家名字 = argv[0]

游戏 = 地牢游戏(冒险者(玩家名字), 演示模式)
游戏.启动冒险()
