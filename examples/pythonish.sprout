def grade(score) {
  if score >= 90 {
    return "A"
  } elif score >= 80 {
    return "B"
  } elif score >= 70 {
    return "C"
  } else {
    return "still growing"
  }
}

scores = {"Ada": 98, "Lin": 84, "Sam": 72}
featured = ["Ada", "Sam"]

for name in scores.keys() {
  if name in featured and not scores[name] < 70 {
    say name, grade(scores[name])
  }
}

total = 0
for name in scores {
  total = total + scores[name]
}

say "average", total // len(scores.keys())
say None == nil, True and not False
