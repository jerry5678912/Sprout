import pixelgarden as pix

canvas = pix.canvas(22, 8, ".")
pix.stroke_rect(canvas, pix.rect(0, 0, 22, 8), "#")
pix.fill_rect(canvas, pix.rect(2, 5, 7, 2), "=")
pix.circle(canvas, pix.circle_shape(15, 3, 2), "o")
pix.text(canvas, 4, 1, "PixelGarden")

hero = pix.sprite_asset([" /\\", "<@>", " /\\"])
spark = pix.sprite_asset(["*", "+"])
effects = pix.layer(22, 8)
pix.draw_sprite(effects, hero, 10, 4, flip_x=True)

twinkle = pix.animation([spark, pix.sprite_asset(["+"])], fps=4)
pix.draw_sprite(effects, pix.animation_frame(twinkle, 0.30), 19, 2)
pix.composite(canvas, effects)

say pix.frame_to_text(canvas)

hero_position = pix.vec2(1, 1)
goal = pix.vec2(5, 4)
say "garden step:", pix.move_toward(hero_position, goal, 2)
say "sprite size:", hero.width, hero.height
