# Sprout3D: a tiny software 3D engine for terminal games and engineering sketches.
# It renders wireframe meshes into an ASCII framebuffer.

def vec3(x=0, y=0, z=0) {
  return {"x": x, "y": y, "z": z}
}

def vadd(a, b) {
  return vec3(a.x + b.x, a.y + b.y, a.z + b.z)
}

def vsub(a, b) {
  return vec3(a.x - b.x, a.y - b.y, a.z - b.z)
}

def vscale(v, amount) {
  return vec3(v.x * amount, v.y * amount, v.z * amount)
}

def dot(a, b) {
  return a.x * b.x + a.y * b.y + a.z * b.z
}

def cross(a, b) {
  return vec3(
    a.y * b.z - a.z * b.y,
    a.z * b.x - a.x * b.z,
    a.x * b.y - a.y * b.x
  )
}

def length(v) {
  return sqrt(dot(v, v))
}

def normalize(v) {
  size = length(v)
  if size == 0 {
    return vec3(0, 0, 0)
  }
  return vscale(v, 1 / size)
}

def mesh(vertices, edges, faces=[]) {
  return {"vertices": vertices, "edges": edges, "faces": faces}
}

def cube(size=2) {
  h = size / 2
  vertices = [
    vec3(0 - h, 0 - h, 0 - h),
    vec3(h, 0 - h, 0 - h),
    vec3(h, h, 0 - h),
    vec3(0 - h, h, 0 - h),
    vec3(0 - h, 0 - h, h),
    vec3(h, 0 - h, h),
    vec3(h, h, h),
    vec3(0 - h, h, h)
  ]
  edges = [
    [0, 1], [1, 2], [2, 3], [3, 0],
    [4, 5], [5, 6], [6, 7], [7, 4],
    [0, 4], [1, 5], [2, 6], [3, 7]
  ]
  faces = [
    [0, 1, 2], [0, 2, 3],
    [4, 6, 5], [4, 7, 6],
    [0, 4, 5], [0, 5, 1],
    [3, 2, 6], [3, 6, 7],
    [1, 5, 6], [1, 6, 2],
    [0, 3, 7], [0, 7, 4]
  ]
  return mesh(vertices, edges, faces)
}

def pyramid(size=2, height=2) {
  h = size / 2
  vertices = [
    vec3(0 - h, 0, 0 - h),
    vec3(h, 0, 0 - h),
    vec3(h, 0, h),
    vec3(0 - h, 0, h),
    vec3(0, height, 0)
  ]
  edges = [
    [0, 1], [1, 2], [2, 3], [3, 0],
    [0, 4], [1, 4], [2, 4], [3, 4]
  ]
  faces = [
    [0, 2, 1], [0, 3, 2],
    [0, 1, 4], [1, 2, 4], [2, 3, 4], [3, 0, 4]
  ]
  return mesh(vertices, edges, faces)
}

def plane(width=2, depth=2) {
  x = width / 2
  z = depth / 2
  return mesh(
    [vec3(0 - x, 0, 0 - z), vec3(x, 0, 0 - z), vec3(x, 0, z), vec3(0 - x, 0, z)],
    [[0, 1], [1, 2], [2, 3], [3, 0]],
    [[0, 2, 1], [0, 3, 2]]
  )
}

def edge_key(a, b) {
  if a < b {
    return str(a) + ":" + str(b)
  }
  return str(b) + ":" + str(a)
}

def unique_edges(edges) {
  seen = {}
  out = []
  for edge in edges {
    key = edge_key(edge[0], edge[1])
    if not has(seen, key) {
      seen[key] = true
      out.append(edge)
    }
  }
  return out
}

def parse_face_index(token) {
  pieces = token.split("/")
  return int(pieces[0]) - 1
}

def obj_record(row) {
  parts = trim(row).split(" ")
  if len(parts) == 0 {
    return {"kind": "", "parts": parts}
  }
  return {"kind": parts[0], "parts": parts}
}

def obj_mesh(text) {
  vertices = []
  edges = []
  faces = []

  for row in text.split("\n") {
    parts = trim(row).split(" ")
    if len(parts) >= 4 {
      if parts[0] == "v" {
        if parts[0] != "" {
          vertices.append(vec3(num(parts[1]), num(parts[2]), num(parts[3])))
        }
      }
    }
  }

  for row in text.split("\n") {
    parts = trim(row).split(" ")
    if len(parts) >= 4 {
      if parts[0] == "f" {
        first = parse_face_index(parts[1])
        i = 2
        limit = len(parts) - 1
        while i < limit {
          a = first
          b = parse_face_index(parts[i])
          c = parse_face_index(parts[i + 1])
          faces.append([a, b, c])
          edges.append([a, b])
          edges.append([b, c])
          edges.append([c, a])
          i = i + 1
        }
      }
    }
  }

  return mesh(vertices, unique_edges(edges), faces)
}

def load_obj(path) {
  return obj_mesh(readfile(path))
}

def translate_mesh(m, offset) {
  vertices = []
  for v in m.vertices {
    vertices.append(vadd(v, offset))
  }
  return mesh(vertices, m.edges, m.faces)
}

def scale_mesh(m, amount) {
  vertices = []
  for v in m.vertices {
    vertices.append(vscale(v, amount))
  }
  return mesh(vertices, m.edges, m.faces)
}

def rotate_x(v, angle) {
  c = cos(angle)
  s = sin(angle)
  return vec3(v.x, v.y * c - v.z * s, v.y * s + v.z * c)
}

def rotate_y(v, angle) {
  c = cos(angle)
  s = sin(angle)
  return vec3(v.x * c + v.z * s, v.y, (0 - v.x) * s + v.z * c)
}

def rotate_z(v, angle) {
  c = cos(angle)
  s = sin(angle)
  return vec3(v.x * c - v.y * s, v.x * s + v.y * c, v.z)
}

def rotate_mesh(m, ax=0, ay=0, az=0) {
  vertices = []
  for v in m.vertices {
    p = rotate_x(v, ax)
    p = rotate_y(p, ay)
    p = rotate_z(p, az)
    vertices.append(p)
  }
  return mesh(vertices, m.edges, m.faces)
}

def transform_mesh(m, position=vec3(0, 0, 0), rotation=vec3(0, 0, 0), scale=1) {
  result = scale_mesh(m, scale)
  result = rotate_mesh(result, rotation.x, rotation.y, rotation.z)
  return translate_mesh(result, position)
}

def merge_meshes(meshes) {
  vertices = []
  edges = []
  faces = []
  offset = 0
  for item in meshes {
    for vertex in item.vertices {
      vertices.append(vertex)
    }
    for edge in item.edges {
      edges.append([edge[0] + offset, edge[1] + offset])
    }
    for face in item.faces {
      faces.append([face[0] + offset, face[1] + offset, face[2] + offset])
    }
    offset = offset + len(item.vertices)
  }
  return mesh(vertices, edges, faces)
}

def camera(position, fov=18, near=0.1) {
  return {"position": position, "fov": fov, "near": near}
}

def look_at_camera(position, target, up=vec3(0, 1, 0), fov=18, near=0.1) {
  forward = normalize(vsub(target, position))
  right = normalize(cross(forward, up))
  if length(right) == 0 {
    right = vec3(1, 0, 0)
  }
  true_up = normalize(cross(right, forward))
  return {
    "position": position,
    "target": target,
    "forward": forward,
    "right": right,
    "up": true_up,
    "fov": fov,
    "near": near
  }
}

def orbit_camera(target, radius=8, yaw=0, pitch=0, fov=18, near=0.1) {
  x = cos(yaw) * cos(pitch) * radius
  y = sin(pitch) * radius
  z = sin(yaw) * cos(pitch) * radius
  position = vadd(target, vec3(x, y, z))
  return look_at_camera(position, target, fov=fov, near=near)
}

def world_to_camera(point, cam) {
  p = vsub(point, cam.position)
  if has(cam, "forward") {
    return vec3(dot(p, cam.right), dot(p, cam.up), dot(p, cam.forward))
  }
  return p
}

def project(point, cam, width, height) {
  p = world_to_camera(point, cam)
  z = p.z
  if z < cam.near {
    z = cam.near
  }
  x = int((p.x * cam.fov / z) + width / 2)
  y = int((0 - p.y * cam.fov / z) + height / 2)
  return {"x": x, "y": y, "z": z}
}

def make_frame(width, height, fill=" ") {
  rows = []
  y = 0
  while y < height {
    row = []
    x = 0
    while x < width {
      row.append(fill)
      x = x + 1
    }
    rows.append(row)
    y = y + 1
  }
  return {"width": width, "height": height, "rows": rows}
}

def make_zbuffer(width, height) {
  rows = []
  y = 0
  while y < height {
    row = []
    x = 0
    while x < width {
      row.append(999999)
      x = x + 1
    }
    rows.append(row)
    y = y + 1
  }
  return {"width": width, "height": height, "rows": rows}
}

def plot(frame, x, y, char="#") {
  if x >= 0 and x < frame.width and y >= 0 and y < frame.height {
    frame.rows[y][x] = char
  }
  return frame
}

def line(frame, x0, y0, x1, y1, char="#") {
  dx = x1 - x0
  dy = y1 - y0
  steps = max(abs(dx), abs(dy))
  if steps == 0 {
    plot(frame, x0, y0, char)
    return frame
  }

  i = 0
  while i <= steps {
    t = i / steps
    x = int(round(lerp(x0, x1, t)))
    y = int(round(lerp(y0, y1, t)))
    plot(frame, x, y, char)
    i = i + 1
  }
  return frame
}

def edge_value(a, b, c) {
  return (c.x - a.x) * (b.y - a.y) - (c.y - a.y) * (b.x - a.x)
}

def shade_char(light, ramp=" .:-=+*#%@") {
  amount = clamp(light, 0, 1)
  idx = int(amount * (len(ramp) - 1))
  return ramp[idx]
}

def face_normal(a, b, c) {
  return normalize(cross(vsub(b, a), vsub(c, a)))
}

def draw_triangle(frame, zbuf, p0, p1, p2, char="#") {
  minx = int(max(0, min(p0.x, p1.x, p2.x)))
  maxx = int(min(frame.width - 1, max(p0.x, p1.x, p2.x)))
  miny = int(max(0, min(p0.y, p1.y, p2.y)))
  maxy = int(min(frame.height - 1, max(p0.y, p1.y, p2.y)))
  area = edge_value(p0, p1, p2)
  if area == 0 {
    return frame
  }

  y = miny
  while y <= maxy {
    x = minx
    while x <= maxx {
      p = {"x": x, "y": y, "z": 0}
      w0 = edge_value(p1, p2, p)
      w1 = edge_value(p2, p0, p)
      w2 = edge_value(p0, p1, p)
      inside_pos = w0 >= 0 and w1 >= 0 and w2 >= 0
      inside_neg = w0 <= 0 and w1 <= 0 and w2 <= 0
      if inside_pos or inside_neg {
        w0 = w0 / area
        w1 = w1 / area
        w2 = w2 / area
        z = p0.z * w0 + p1.z * w1 + p2.z * w2
        if z < zbuf.rows[y][x] {
          zbuf.rows[y][x] = z
          frame.rows[y][x] = char
        }
      }
      x = x + 1
    }
    y = y + 1
  }
  return frame
}

def render_solid(m, cam, width=48, height=22, light_dir=vec3(0, 0, -1), ramp=" .:-=+*#%@") {
  frame = make_frame(width, height, " ")
  zbuf = make_zbuffer(width, height)
  points = []
  for v in m.vertices {
    points.append(project(v, cam, width, height))
  }

  light = normalize(light_dir)
  for face in m.faces {
    a3 = m.vertices[face[0]]
    b3 = m.vertices[face[1]]
    c3 = m.vertices[face[2]]
    normal = face_normal(a3, b3, c3)
    brightness = max(0.12, dot(normal, light))
    char = shade_char(brightness, ramp)
    a = points[face[0]]
    b = points[face[1]]
    c = points[face[2]]
    draw_triangle(frame, zbuf, a, b, c, char)
  }
  return frame
}

def render_wireframe(m, cam, width=48, height=22, char="#") {
  frame = make_frame(width, height, " ")
  points = []
  for v in m.vertices {
    points.append(project(v, cam, width, height))
  }

  for edge in m.edges {
    a = points[edge[0]]
    b = points[edge[1]]
    line(frame, a.x, a.y, b.x, b.y, char)
  }

  return frame
}

def frame_to_text(frame) {
  lines_out = []
  for row in frame.rows {
    lines_out.append(row.join(""))
  }
  return lines_out.join("\n")
}

def bounds(m) {
  minx = m.vertices[0].x
  miny = m.vertices[0].y
  minz = m.vertices[0].z
  maxx = minx
  maxy = miny
  maxz = minz
  for v in m.vertices {
    minx = min(minx, v.x)
    miny = min(miny, v.y)
    minz = min(minz, v.z)
    maxx = max(maxx, v.x)
    maxy = max(maxy, v.y)
    maxz = max(maxz, v.z)
  }
  return {"min": vec3(minx, miny, minz), "max": vec3(maxx, maxy, maxz)}
}
