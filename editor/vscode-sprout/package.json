{
  "name": "sprout-language",
  "displayName": "Sprout Language",
  "description": "Syntax highlighting, snippets, completions, and editor basics for the Sprout programming language.",
  "version": "0.3.3",
  "publisher": "jerry5678912",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jerry5678912/Sprout.git"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:sprout",
    "onDebug:sprout",
    "onCommand:sprout.selectInterpreter",
    "onCommand:sprout.runCurrentFile",
    "onCommand:sprout.showLanguageServerOutput",
    "onCommand:sprout.restartLanguageServer",
    "onCommand:sprout.showAnalysisStatus",
    "onCommand:sprout.rebuildWorkspaceIndex"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sprout.selectInterpreter",
        "title": "Select Interpreter",
        "category": "Sprout",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sprout.runCurrentFile",
        "title": "Run Current File",
        "category": "Sprout",
        "icon": "$(play)"
      },
      {
        "command": "sprout.showLanguageServerOutput",
        "title": "Show Language Server Output",
        "category": "Sprout",
        "icon": "$(output)"
      },
      {
        "command": "sprout.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Sprout",
        "icon": "$(debug-restart)"
      },
      {
        "command": "sprout.showAnalysisStatus",
        "title": "Show Analysis Status",
        "category": "Sprout",
        "icon": "$(graph)"
      },
      {
        "command": "sprout.rebuildWorkspaceIndex",
        "title": "Rebuild Workspace Index",
        "category": "Sprout",
        "icon": "$(refresh)"
      },
      {
        "command": "sprout.smartEnter",
        "title": "Smart Enter",
        "category": "Sprout"
      }
    ],
    "keybindings": [
      {
        "command": "sprout.smartEnter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == sprout && !editorReadonly && !suggestWidgetVisible && !inSnippetMode && !renameInputVisible"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sprout.runCurrentFile",
          "when": "editorLangId == sprout",
          "group": "navigation@1"
        }
      ]
    },
    "languages": [
      {
        "id": "sprout",
        "aliases": [
          "Sprout",
          "sprout"
        ],
        "extensions": [
          ".sprout"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sprout",
        "scopeName": "source.sprout",
        "path": "./syntaxes/sprout.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "sprout"
      }
    ],
    "debuggers": [
      {
        "type": "sprout",
        "label": "Sprout",
        "languages": [
          "sprout"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Sprout file to debug."
              },
              "args": {
                "type": "array",
                "description": "Arguments passed to the Sprout program.",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause on the first executable Sprout line.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "sprout",
            "request": "launch",
            "name": "Debug current Sprout file",
            "program": "${file}",
            "args": [],
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Sprout: Debug current file",
            "description": "Debug the currently open Sprout file with the bytecode VM.",
            "body": {
              "type": "sprout",
              "request": "launch",
              "name": "Debug current Sprout file",
              "program": "${file}",
              "args": [],
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
        "snippets": [
            {
                "language": "sprout",
                "path": "./snippets/sprout.code-snippets"
            }
        ],
        "semanticTokenTypes": [
            {
                "id": "class",
                "description": "Sprout class names"
            },
            {
                "id": "function",
                "description": "Sprout function names"
            },
            {
                "id": "method",
                "description": "Sprout method names"
            },
            {
                "id": "variable",
                "description": "Sprout variable names"
            },
            {
                "id": "parameter",
                "description": "Sprout function parameters"
            },
            {
                "id": "property",
                "description": "Sprout instance and module properties"
            }
        ],
        "configurationDefaults": {
            "[sprout]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.wordBasedSuggestions": "off",
                "editor.suggest.showWords": false,
                "editor.snippetSuggestions": "none"
            },
            "editor.semanticTokenColorCustomizations": {
                "rules": {
                    "*.sprout": "#D4D4D4",
                    "class:sprout": "#4EC9B0",
                    "function:sprout": "#DCDCAA",
                    "method:sprout": "#DCDCAA",
                    "variable:sprout": "#9CDCFE",
                    "parameter:sprout": "#9CDCFE",
                    "property:sprout": "#9CDCFE"
                }
            }
        },
        "configuration": {
      "title": "Sprout",
      "properties": {
        "sprout.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run Sprout syntax diagnostics in the editor."
        },
        "sprout.diagnostics.styleWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show yellow Sprout style warnings for indentation issues and Python-style constants."
        },
        "sprout.diagnostics.visibleSquiggles": {
          "type": "boolean",
          "default": true,
          "description": "Show diagnostics as visible squiggle underlines in editors."
        },
        "sprout.diagnostics.typoChecking": {
          "type": "boolean",
          "default": true,
          "description": "Suggest corrections for mistyped Sprout keywords, built-ins, imports, and project symbols."
        },
        "sprout.analysis.typeCheckingMode": {
          "type": "string",
          "enum": [
            "off",
            "basic",
            "standard",
            "strict"
          ],
          "default": "basic",
          "enumDescriptions": [
            "Report syntax and import errors only.",
            "Report practical semantic and type errors without requiring annotations.",
            "Report broader semantic and type errors with stronger project-wide checking.",
            "Enable the strongest checks, including missing annotations and stricter unknown-name/member errors."
          ],
          "description": "Controls Sprout semantic and type-checking diagnostics."
        },
        "sprout.analysis.diagnosticMode": {
          "type": "string",
          "enum": [
            "workspace",
            "openFilesOnly"
          ],
          "default": "workspace",
          "description": "Choose whether Sprout analyzes the whole workspace graph or focuses on currently open files."
        },
        "sprout.analysis.indexing": {
          "type": "boolean",
          "default": true,
          "description": "Enable dependency-aware workspace indexing for Sprout IntelliSense."
        },
        "sprout.analysis.userFileIndexingLimit": {
          "type": "number",
          "default": 2000,
          "minimum": 1,
          "description": "Maximum number of user Sprout files to index before the server throttles scanning."
        },
        "sprout.analysis.useLibraryCodeForTypes": {
          "type": "boolean",
          "default": true,
          "description": "Use Sprout library source when inferring types and symbols."
        },
        "sprout.analysis.exclude": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns excluded from Sprout workspace indexing."
        },
        "sprout.analysis.languageServerMode": {
          "type": "string",
          "enum": [
            "default",
            "light",
            "off"
          ],
          "default": "default",
          "description": "Tune Sprout language-server workload for full, lighter, or minimal analysis behavior."
        },
        "sprout.analysis.diagnosticSeverityOverrides": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "none",
              "hint",
              "information",
              "warning",
              "error"
            ]
          },
          "description": "Override a Sprout diagnostic code, for example { \"SPROUT_UNUSED_IMPORT\": \"information\" }."
        },
        "sprout.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable used to run sprout.py. Empty selects python on Windows and python3 elsewhere."
        },
        "sprout.runnerPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to the selected sprout.py interpreter. Use 'Sprout: Select Interpreter' to choose one. When empty, the extension automatically discovers the bundled or workspace interpreter."
        },
        "sprout.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use the persistent Sprout language server for diagnostics and IntelliSense."
        }
      }
    }
  }
}
