{
  "scopeName": "source.sprout",
  "name": "Sprout",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#specials" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.sprout",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sprout",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sprout",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sprout",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.class.sprout",
          "match": "(?<![\\p{L}\\p{N}_])(class|interface|enum|类|接口|枚举)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "keyword.control.class.sprout" },
            "2": { "name": "entity.name.type.class.sprout" }
          }
        },
        {
          "name": "meta.function.sprout",
          "match": "(?<![\\p{L}\\p{N}_])(?:(?:async|异步)\\s+)?(fn|def|bloom|匿名函数|定义|函数|开始)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "storage.type.function.sprout" },
            "2": { "name": "entity.name.function.sprout" }
          }
        },
        {
          "name": "variable.other.assignment.sprout",
          "match": "^\\s*(?:(?:let|sprout|令|萌发)\\s+)?([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*=)",
          "captures": {
            "1": { "name": "variable.other.assignment.sprout" }
          }
        },
        {
          "name": "variable.parameter.self.sprout",
          "match": "\\bself\\b"
        },
        {
          "name": "entity.name.type.sprout",
          "match": "(?<=:\\s)[A-Z][A-Za-z0-9_]*(?:\\[[A-Za-z0-9_, ]+\\])?|(?<=->\\s)[A-Z][A-Za-z0-9_]*(?:\\[[A-Za-z0-9_, ]+\\])?"
        },
        {
          "name": "variable.other.property.sprout",
          "match": "(?<=\\.)[\\p{L}_][\\p{L}\\p{N}_]*"
        },
        {
          "name": "support.class.sprout",
          "match": "(?<![\\p{L}\\p{N}_])[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sprout",
          "match": "(?<![\\p{L}\\p{N}_])(if|elif|else|end|while|whirl|for|each|in|is|break|continue|return|yield|pluck|try|catch|raise|test|import|importpython|as|and|or|not|class|interface|enum|match|case|implements|extends|super|async|await|taskgroup|如果|否则如果|否则|结束|当|循环|对于|每个|在|是|跳出|继续|返回|产出|采收|尝试|捕获|抛出|测试|导入|导入Python|作为|且|或|非|类|接口|枚举|匹配|分支|实现|继承|父类|异步|等待|任务组)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "storage.type.function.sprout",
          "match": "(?<![\\p{L}\\p{N}_])(fn|def|bloom|seedfn|匿名函数|定义|函数|开始|生成器函数)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "storage.modifier.sprout",
          "match": "(?<![\\p{L}\\p{N}_])(let|sprout|令|萌发)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "constant.language.sprout",
          "match": "(?<![\\p{L}\\p{N}_])(True|false|nil|真|假|空)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "specials": {
      "patterns": [
        {
          "name": "support.function.special.sprout",
          "match": "\\b(say|sparkle|whisper|shout|mirror|chant|weave|grow|plant|harvest|prune|sprinkle|bundle|first|last|rest|unique|countby|zipbud|dice|choose|clamp|wrap|dist|sleep|now|lerp|between|rand|randint|seed|shuffle|sample)\\b"
        },
        {
          "name": "support.function.builtin.sprout",
          "match": "\\b(len|push|range|str|int|num|type|keys|values|items|has|get|readfile|writefile|readfile_async|writefile_async|appendfile|exists|isfile|isdir|listdir|mkdir|readjson|writejson|py_available|py_import|lines|argv|ask|clear|ensure|fail|expect|functions|methods|task_spawn|task_after|task_wait_all|queue_open|stream_open|cancel_token|sleep_async|http_get|http_post|http_request|http_get_async|http_post_async|http_request_async|http_server|sqlite_open|sqlite_exec|sqlite_query|sqlite_begin|sqlite_commit|sqlite_rollback|sqlite_close|vec_add|vec_sub|vec_dot|vec_magnitude|vec_normalize|mat_mul|unit_convert|interpolate|kinetic_energy|force|pressure|abs|acos|array|asin|atan|atan2|avg|basename|ceil|chars|chunks|compact|concat|contains|copy|cos|cwd|degrees|delkey|dict|dirname|drop|endswith|enumerate|exp|extname|fill|flatten|floor|frompairs|hypot|indexof|insert|is_array|is_bool|is_class|is_dict|is_empty|is_even|is_function|is_instance|is_nil|is_number|is_odd|is_string|join|joinpath|json_parse|json_stringify|log|log10|lower|ltrim|max|median|merge|min|omit|padleft|padright|pick|pow|radians|remove|repeat|replace|reverse|round|rtrim|sign|sin|slice|sort|sqrt|startswith|substr|sum|take|tan|title|trim|upper|words)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.sprout",
          "match": "(?<=\\s)[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
        },
        {
          "name": "support.function.method.sprout",
          "match": "\\.[\\p{L}_][\\p{L}\\p{N}_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sprout",
          "match": "->|=>|==|!=|<=|>=|//|\\*\\*|[+\\-*/%=<>!|?]"
        }
      ]
    }
  }
}
